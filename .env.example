CM_NAS_IP=192.168.1.100
CM_DEFAULT_SCHEME=http
CM_COMPOSE_PATH=/volume1/docker

# ---- 登录认证 ----
# 不设置 CM_AUTH_PASSWORD / CM_AUTH_PASSWORD_HASH 时不启用登录，行为与旧版本一致。
# 两项同时设置时以哈希为准；推荐用哈希，避免明文口令落在部署文件里。
# 生成哈希：docker run --rm <镜像> -hash-password '你的口令'
CM_AUTH_USER=admin
CM_AUTH_PASSWORD=
CM_AUTH_PASSWORD_HASH=

# 会话有效期；通过 HTTPS 域名（如 Cloudflare 隧道）访问时把 CM_COOKIE_SECURE 设为 true。
CM_SESSION_TTL=12h
CM_COOKIE_SECURE=false

# 会话签名密钥。留空则自动生成并落盘到 /data/.session-secret（容器重启不掉登录态）。
# 需要立即吊销全部会话时，填一个新的 64 位十六进制值并重建容器。
CM_SESSION_SECRET=

CM_NAS_IP=192.168.1.100
CM_DEFAULT_SCHEME=http
CM_COMPOSE_PATH=/volume1/docker
CM_SECURE_COOKIE=false
CM_SESSION_TTL=168h
# 可选：镜像版本检查代理；实际 pull 使用 NAS Docker Engine 自身代理。
CM_PROXY_URL=
# 下载镜像或重建容器的单阶段超时。
CM_OPERATION_TIMEOUT=15m
# 可选：固定首次初始化密钥；留空时由服务自动生成并写入容器日志。
# CM_SETUP_TOKEN=replace-with-a-long-random-value
